# Copia este archivo a ".env.meta-test" y llena tus valores reales ahí.
# NUNCA pegues estos valores en el chat, ni subas ".env.meta-test" a git
# (ya está en .gitignore, pero revisa antes de un commit si tienes duda).

# Token de acceso de la app de Meta (Panel > Casos de uso > WhatsApp > API Setup)
META_JWT_TOKEN=

# Phone Number ID del número de prueba (se ve en la misma pantalla)
META_NUMBER_ID=

# Cualquier texto que tú inventes — debe ser IDÉNTICO al que pongas en el
# panel de Meta al configurar el webhook (campo "Verify token").
META_VERIFY_TOKEN=

# Puerto local donde corre este bot de prueba (el túnel apunta aquí)
META_TEST_PORT=3010
