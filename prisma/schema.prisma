generator client {
  provider      = "prisma-client-js"
  // "native" para desarrollo local (Windows/Mac/Linux) y "rhel-openssl-3.0.x" para el
  // runtime de funciones serverless de Vercel — sin este segundo target, el motor de
  // Prisma compilado en tu máquina no corre una vez desplegado.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  ACTIVE
  PAST_DUE
  PAUSED
}

enum FlowMessageKey {
  WELCOME
  SERVICES_INTRO
  BOOKING_ASK_DAY
  BOOKING_ASK_TIME
  BOOKING_CONFIRMED
  CONTACT
  CLOSED
  FALLBACK
}

enum BookingStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum StaffRole {
  ADMIN
  USUARIO
}

enum Module {
  CITAS
  SERVICIOS
  PRODUCTOS
  FINANZAS
  BOT
  SEGURIDAD
}

enum ExpenseCategory {
  RENTA
  INSUMOS
  SERVICIOS
  NOMINA
  OTRO
}

// Los 9 métodos de pago más usados en México + "otro" como comodín.
enum PaymentMethod {
  EFECTIVO
  TARJETA_DEBITO
  TARJETA_CREDITO
  TRANSFERENCIA
  DEPOSITO
  PAYPAL
  MERCADO_PAGO
  CODI
  VALES_DESPENSA
  OTRO
}

// Qué métodos de pago acepta CADA barbería — sin fila para un método, se asume activo
// (así ningún tenant existente se queda sin nada al agregar esto). EFECTIVO nunca se
// puede desactivar (se valida en el servidor, no solo en la interfaz): siempre debe
// quedar al menos una forma de cobrar disponible.
model TenantPaymentMethod {
  id       String        @id @default(cuid())
  tenantId String
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  method   PaymentMethod
  active   Boolean       @default(true)

  @@unique([tenantId, method])
}

enum PaymentStatus {
  PAGADO
  PARCIAL
  NO_PAGADO
}

enum ShiftStatus {
  ABIERTO
  CERRADO
}

enum BarberPaymentType {
  COMISION
  SUELDO
  MIXTO
}

// El dueño de la plataforma (tú) — separado de StaffUser porque no pertenece a ninguna barbería.
model SuperAdmin {
  id             String   @id @default(cuid())
  username       String   @unique
  passwordHash   String
  name           String
  // Se incrementa para invalidar de golpe cualquier sesión ya emitida (ej. tras
  // cambiar la contraseña) sin necesidad de una tabla de sesiones activas.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
}

// Intentos fallidos de login, usados por lib/rate-limit.js. Antes vivía en un Map en
// memoria del proceso, lo cual no sirve en un entorno serverless (Vercel) donde cada
// invocación puede caer en una instancia distinta sin memoria compartida.
model LoginAttempt {
  key             String   @id // ej. "staff:<slug>:<username>" o "admin:<username>"
  count           Int      @default(1)
  firstAttemptAt  DateTime @default(now())
}

model Tenant {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  ownerName      String?
  whatsappNumber String?      @unique
  // --- Conexión vía API oficial de Meta (Cloud API), independiente de Baileys ---
  metaPhoneNumberId String? @unique // Phone Number ID que Meta asigna al número de esta barbería
  metaAccessToken   String? // token permanente (System User) para mandar mensajes desde ese número
  metaPort          Int?    @unique // puerto local donde corre el proceso Meta de esta barbería
  // Minutos de anticipación mínima para aceptar una cita por WhatsApp: evita que
  // alguien agende "ya mismo" cuando la barbería está por cerrar o sin margen.
  bookingMinNoticeMin Int @default(30)
  // Contadores para el folio consecutivo que se le pone a cada venta/gasto (ProductSale y
  // ServiceSale comparten uno solo, porque en pantalla se ven mezclados en una sola lista
  // de "Ventas" — si cada tabla llevara su propio contador, dos ventas seguidas podrían
  // mostrar el mismo número). Se incrementan con un UPDATE atómico, no hace falta
  // transacción aparte.
  saleFolioSeq    Int @default(0)
  expenseFolioSeq Int @default(0)
  status         TenantStatus @default(ACTIVE)
  planPriceCents Int          @default(20000)
  nextDueDate    DateTime?
  logoUrl        String?
  brandColor     String       @default("#D9A441")
  createdAt      DateTime     @default(now())

  services     Service[]
  products     Product[]
  promotions   Promotion[]
  flowMessages FlowMessage[]
  bookings     Booking[]
  payments     Payment[]
  productSales     ProductSale[]
  users            StaffUser[]
  expenses         Expense[]
  businessHours    BusinessHour[]
  ignoredContacts  IgnoredContact[]
  barbers          Barber[]
  customers        Customer[]
  serviceSales     ServiceSale[]
  shiftTypes       ShiftType[]
  cashShifts       CashShift[]
  conversationStates ConversationState[]
  whatsappMessages   WhatsappMessage[]
  inventoryMovements InventoryMovement[]
  cashMovements      CashMovement[]
  paymentMethods     TenantPaymentMethod[]
}

// Progreso de una conversación de WhatsApp en curso, para no perderlo si el proceso del
// bot se reinicia (PM2 lo reinicia solo ante cualquier caída). Se guarda en cada paso del
// flujo de agendado; flowBienvenida la revisa al recibir un nuevo mensaje del mismo
// teléfono. Filas con más de un par de horas de antigüedad se consideran vencidas.
model ConversationState {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone      String
  step       String? // ej. "ask_day", "ask_time", "done"
  data       Json      @default("{}")
  // Mientras esta fecha esté en el futuro, el bot deja de contestarle automático a este
  // cliente — se activa cuando el cliente pide hablar con una persona, o cuando un
  // usuario del staff le contesta manual desde la bandeja de chat (ver ChatInbox.js).
  humanUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId, updatedAt])
}

// Historial de mensajes de WhatsApp (entrantes y salientes) para la bandeja de chat del
// panel — antes de esto, el bot procesaba cada mensaje pero no quedaba ningún registro
// de la conversación en ningún lado visible para el dueño de la barbería.
model WhatsappMessage {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone      String
  direction  String // "in" (del cliente) | "out" (del bot o de un humano del staff)
  body       String
  sentByName String? // nombre del usuario del staff si un humano lo mandó; null = lo mandó el bot
  createdAt  DateTime @default(now())

  @@index([tenantId, phone, createdAt])
  @@index([tenantId, createdAt])
}

// Tipos de turno configurables por barbería (ej. "Mañana", "Tarde", "Día completo").
model ShiftType {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  shifts    CashShift[]

  @@unique([tenantId, name])
}

// Un turno de caja: se abre al iniciar sesión (con monto inicial) y se cierra al terminar
// (con monto final contado). Solo el efectivo entra a la reconciliación de caja.
model CashShift {
  id                  String      @id @default(cuid())
  tenantId            String
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shiftTypeId         String?
  shiftType           ShiftType?  @relation(fields: [shiftTypeId], references: [id], onDelete: SetNull)
  status              ShiftStatus @default(ABIERTO)
  openedByName        String
  closedByName        String?
  openingCashCents    Int
  closingCashCents    Int?
  cashRevenueCents    Int?
  cashExpenseCents    Int?
  expectedCashCents   Int?
  cashDifferenceCents Int?
  totalRevenueCents   Int?
  totalExpenseCents   Int?
  salesCount          Int?
  notes               String?
  startedAt           DateTime    @default(now())
  endedAt             DateTime?

  cashMovements CashMovement[]
  // Qué se cobró/gastó durante este turno. Es un vínculo explícito, no un rango de fechas:
  // la fecha de una venta se puede editar, pero el cajón donde entró el dinero no cambia.
  productSales  ProductSale[]
  serviceSales  ServiceSale[]
  expenses      Expense[]

  @@index([tenantId, startedAt])
  @@index([tenantId, status])
}

enum CashMovementType {
  RETIRO
  DEPOSITO
}

// Entrada/salida de efectivo de la caja MIENTRAS el turno sigue abierto (ej. el dueño saca
// dinero para un pago urgente, o mete cambio) — sin esto, solo se podía saber el faltante/
// sobrante hasta cerrar el turno, sin dejar rastro de por qué no cuadraba.
model CashMovement {
  id            String           @id @default(cuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashShiftId   String
  cashShift     CashShift        @relation(fields: [cashShiftId], references: [id], onDelete: Cascade)
  type          CashMovementType
  amountCents   Int
  reason        String?
  createdByName String
  createdAt     DateTime         @default(now())

  @@index([tenantId, cashShiftId])
}

// Cliente registrado de la barbería (para no volver a escribir nombre/teléfono cada vez).
model Customer {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  phone             String
  notes             String?
  email             String?
  birthDate         DateTime?
  preferredBarberId String?
  preferredBarber   Barber?   @relation(fields: [preferredBarberId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())

  bookings     Booking[]
  productSales ProductSale[]
  serviceSales ServiceSale[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

// Venta de un servicio cobrado directo en el mostrador (sin pasar por el flujo de Agenda/citas).
model ServiceSale {
  id            String        @id @default(cuid())
  folio         Int           @default(0)
  // Las ventas no se borran nunca: se cancelan. Así queda rastro de lo que se registró
  // por error (o a propósito) en vez de que desaparezca sin dejar huella. Una venta con
  // cancelledAt != null no cuenta para ingresos, caja, comisiones ni finanzas.
  cancelledAt     DateTime?
  cancelledByName String?
  cancelReason    String?
  // Turno (caja) en el que se cobró. Se fija al registrar la venta y ya no cambia.
  cashShiftId   String?
  cashShift     CashShift?    @relation(fields: [cashShiftId], references: [id], onDelete: SetNull)
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service?      @relation(fields: [serviceId], references: [id])
  serviceName   String
  priceCents    Int
  barberId      String?
  barber        Barber?       @relation(fields: [barberId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod @default(EFECTIVO)
  paymentStatus PaymentStatus @default(PAGADO)
  amountPaidCents Int         @default(0)
  quantity      Int           @default(1)
  discountCents Int           @default(0)
  tipCents      Int           @default(0)
  notes         String?
  createdAt     DateTime      @default(now())

  @@index([tenantId, createdAt])
}

// Barbero/empleado al que se le puede asignar una cita o venta, para calcular su comisión.
model Barber {
  id                String            @id @default(cuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  phone             String?
  specialty         String?
  paymentType       BarberPaymentType @default(COMISION)
  commissionPercent Float             @default(40)
  salaryCents       Int?
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())

  bookings          Booking[]
  productSales      ProductSale[]
  serviceSales      ServiceSale[]
  preferredByCustomers Customer[]

  @@index([tenantId])
  @@index([tenantId, active])
}

// Números que el bot debe ignorar por completo (ej. contactos personales del dueño, si usa su número propio).
model IgnoredContact {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone     String
  label     String?
  createdAt DateTime @default(now())

  @@unique([tenantId, phone])
}

// weekday: 0=domingo, 1=lunes, ... 6=sábado. open/closeMin: minutos desde medianoche (9:00 = 540).
model BusinessHour {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  weekday  Int
  isClosed Boolean @default(false)
  openMin  Int     @default(540)
  closeMin Int     @default(1200)

  @@unique([tenantId, weekday])
}

model StaffUser {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  username     String
  passwordHash String
  role         StaffRole @default(USUARIO)
  // Cuenta desactivada = no puede iniciar sesión ni mantener una sesión ya abierta,
  // sin perder el historial de citas/ventas que la referencian (a diferencia de borrarla).
  active         Boolean @default(true)
  // Se incrementa al cambiar la contraseña o al forzar el cierre de sesión — cualquier
  // cookie firmada con una versión distinta deja de ser válida de inmediato.
  sessionVersion Int     @default(0)

  permissions Permission[]
  pushTokens  PushToken[]
  createdAt   DateTime     @default(now())

  @@unique([tenantId, username])
}

// Token del dispositivo (celular) de cada usuario, para poder mandarle notificaciones push.
model PushToken {
  id          String    @id @default(cuid())
  staffUserId String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  token       String    @unique
  platform    String    @default("android")
  createdAt   DateTime  @default(now())
}

model Permission {
  id          String    @id @default(cuid())
  staffUserId String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  module      Module
  canView     Boolean   @default(false)
  canAdd      Boolean   @default(false)
  canEdit     Boolean   @default(false)
  canDelete   Boolean   @default(false)

  @@unique([staffUserId, module])
}

model Expense {
  id          String          @id @default(cuid())
  folio       Int             @default(0)
  // Igual que las ventas: los gastos no se borran, se cancelan. Un gasto cancelado deja
  // de contar para finanzas y para el efectivo de la caja, pero el registro se queda.
  cancelledAt     DateTime?
  cancelledByName String?
  cancelReason    String?
  // Turno (caja) en el que se registró el gasto. Se fija al crearlo y ya no cambia.
  cashShiftId String?
  cashShift   CashShift?      @relation(fields: [cashShiftId], references: [id], onDelete: SetNull)
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  description String
  amountCents Int
  // Si el gasto es una compra de stock a proveedor: qué producto y cuántas piezas se sumaron.
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity    Int?
  paymentMethod PaymentMethod @default(EFECTIVO)
  // Solo aplica a gastos en EFECTIVO: distingue el dinero que salió del cajón del turno
  // (el proveedor que llegó a media tarde) del que se pagó por fuera (la renta, la luz,
  // que el dueño paga de su bolsa o del banco). Sin esta distinción, registrar la renta
  // dejaba la caja con un faltante fantasma. Default true = comportamiento anterior, para
  // no cambiarle el saldo a los gastos ya registrados.
  fromCashRegister Boolean       @default(true)
  vendor        String?
  receiptNumber String?
  isRecurring   Boolean         @default(false)
  paidByName    String?
  createdAt   DateTime        @default(now())

  @@index([tenantId, createdAt])
}

model Service {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  priceCents  Int
  durationMin Int     @default(30)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  bookings     Booking[]
  serviceSales ServiceSale[]

  @@index([tenantId])
  @@index([tenantId, active])
}

model Product {
  id                 String  @id @default(cuid())
  tenantId           String
  tenant             Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  priceCents         Int
  stock              Int     @default(0)
  lowStockThreshold  Int     @default(3)
  active             Boolean @default(true)
  sortOrder          Int     @default(0)

  sales     ProductSale[]
  expenses  Expense[]
  movements InventoryMovement[]

  @@index([tenantId])
  @@index([tenantId, active])
}

enum InventoryMovementType {
  ENTRADA
  SALIDA
}

// Historial de movimientos de stock (entradas/salidas), separado del catálogo de
// productos (especificaciones) — Product.stock sigue siendo el número actual "en caché"
// para no tener que sumar todo el historial cada vez que se necesita, pero cada cambio a
// ese número (venta, compra, ajuste manual) también queda registrado aquí para auditoría.
model InventoryMovement {
  id            String                @id @default(cuid())
  tenantId      String
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId     String
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          InventoryMovementType
  quantity      Int
  reason        String?
  createdByName String?
  createdAt     DateTime              @default(now())

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, createdAt])
}

model ProductSale {
  id            String        @id @default(cuid())
  folio         Int           @default(0)
  // Ver ServiceSale: se cancelan, no se borran. Al cancelar una venta de producto el
  // stock se devuelve al inventario con su propio InventoryMovement.
  cancelledAt     DateTime?
  cancelledByName String?
  cancelReason    String?
  // Turno (caja) en el que se cobró. Se fija al registrar la venta y ya no cambia.
  cashShiftId   String?
  cashShift     CashShift?    @relation(fields: [cashShiftId], references: [id], onDelete: SetNull)
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])
  productName   String
  priceCents    Int
  barberId      String?
  barber        Barber?       @relation(fields: [barberId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod @default(EFECTIVO)
  paymentStatus PaymentStatus @default(PAGADO)
  amountPaidCents Int         @default(0)
  quantity      Int           @default(1)
  discountCents Int           @default(0)
  tipCents      Int           @default(0)
  notes         String?
  createdAt     DateTime      @default(now())

  @@index([tenantId, createdAt])
}

model Promotion {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  text      String
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean   @default(true)

  @@index([tenantId])
}

model FlowMessage {
  id       String         @id @default(cuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key      FlowMessageKey
  text     String

  @@unique([tenantId, key])
}

model Booking {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerName      String?
  customerPhone     String
  serviceId         String?
  service           Service?       @relation(fields: [serviceId], references: [id])
  barberId          String?
  barber            Barber?        @relation(fields: [barberId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  day               String
  time              String
  scheduledAt       DateTime?
  durationMin       Int            @default(30)
  status            BookingStatus  @default(PENDING)
  priceChargedCents Int?
  paymentMethod     PaymentMethod?
  paymentStatus     PaymentStatus  @default(PAGADO)
  amountPaidCents   Int            @default(0)
  reminderSentAt    DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, status])
}

model Payment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amountCents Int
  paidAt     DateTime @default(now())
  periodEnd  DateTime

  @@index([tenantId])
}
