generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  PAST_DUE
  PAUSED
}

enum FlowMessageKey {
  WELCOME
  SERVICES_INTRO
  BOOKING_ASK_DAY
  BOOKING_ASK_TIME
  BOOKING_CONFIRMED
  CONTACT
  CLOSED
}

enum BookingStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum StaffRole {
  ADMIN
  USUARIO
}

enum Module {
  CITAS
  SERVICIOS
  PRODUCTOS
  FINANZAS
  BOT
  SEGURIDAD
}

enum ExpenseCategory {
  RENTA
  INSUMOS
  SERVICIOS
  NOMINA
  OTRO
}

// Los 9 métodos de pago más usados en México + "otro" como comodín.
enum PaymentMethod {
  EFECTIVO
  TARJETA_DEBITO
  TARJETA_CREDITO
  TRANSFERENCIA
  DEPOSITO
  PAYPAL
  MERCADO_PAGO
  CODI
  VALES_DESPENSA
  OTRO
}

enum PaymentStatus {
  PAGADO
  PARCIAL
  NO_PAGADO
}

enum ShiftStatus {
  ABIERTO
  CERRADO
}

enum BarberPaymentType {
  COMISION
  SUELDO
  MIXTO
}

// El dueño de la plataforma (tú) — separado de StaffUser porque no pertenece a ninguna barbería.
model SuperAdmin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Tenant {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  ownerName      String?
  whatsappNumber String?      @unique
  // --- Conexión vía API oficial de Meta (Cloud API), independiente de Baileys ---
  metaPhoneNumberId String? @unique // Phone Number ID que Meta asigna al número de esta barbería
  metaAccessToken   String? // token permanente (System User) para mandar mensajes desde ese número
  metaPort          Int?    @unique // puerto local donde corre el proceso Meta de esta barbería
  // Minutos de anticipación mínima para aceptar una cita por WhatsApp: evita que
  // alguien agende "ya mismo" cuando la barbería está por cerrar o sin margen.
  bookingMinNoticeMin Int @default(30)
  status         TenantStatus @default(ACTIVE)
  planPriceCents Int          @default(20000)
  nextDueDate    DateTime?
  logoUrl        String?
  brandColor     String       @default("#D9A441")
  createdAt      DateTime     @default(now())

  services     Service[]
  products     Product[]
  promotions   Promotion[]
  flowMessages FlowMessage[]
  bookings     Booking[]
  payments     Payment[]
  productSales     ProductSale[]
  users            StaffUser[]
  expenses         Expense[]
  businessHours    BusinessHour[]
  ignoredContacts  IgnoredContact[]
  barbers          Barber[]
  customers        Customer[]
  serviceSales     ServiceSale[]
  shiftTypes       ShiftType[]
  cashShifts       CashShift[]
}

// Tipos de turno configurables por barbería (ej. "Mañana", "Tarde", "Día completo").
model ShiftType {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  shifts    CashShift[]

  @@unique([tenantId, name])
}

// Un turno de caja: se abre al iniciar sesión (con monto inicial) y se cierra al terminar
// (con monto final contado). Solo el efectivo entra a la reconciliación de caja.
model CashShift {
  id                  String      @id @default(cuid())
  tenantId            String
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shiftTypeId         String?
  shiftType           ShiftType?  @relation(fields: [shiftTypeId], references: [id], onDelete: SetNull)
  status              ShiftStatus @default(ABIERTO)
  openedByName        String
  closedByName        String?
  openingCashCents    Int
  closingCashCents    Int?
  cashRevenueCents    Int?
  cashExpenseCents    Int?
  expectedCashCents   Int?
  cashDifferenceCents Int?
  totalRevenueCents   Int?
  totalExpenseCents   Int?
  salesCount          Int?
  notes               String?
  startedAt           DateTime    @default(now())
  endedAt             DateTime?

  @@index([tenantId, startedAt])
  @@index([tenantId, status])
}

// Cliente registrado de la barbería (para no volver a escribir nombre/teléfono cada vez).
model Customer {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  phone             String
  notes             String?
  email             String?
  birthDate         DateTime?
  preferredBarberId String?
  preferredBarber   Barber?   @relation(fields: [preferredBarberId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())

  bookings     Booking[]
  productSales ProductSale[]
  serviceSales ServiceSale[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

// Venta de un servicio cobrado directo en el mostrador (sin pasar por el flujo de Agenda/citas).
model ServiceSale {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service?      @relation(fields: [serviceId], references: [id])
  serviceName   String
  priceCents    Int
  barberId      String?
  barber        Barber?       @relation(fields: [barberId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod @default(EFECTIVO)
  paymentStatus PaymentStatus @default(PAGADO)
  amountPaidCents Int         @default(0)
  quantity      Int           @default(1)
  discountCents Int           @default(0)
  tipCents      Int           @default(0)
  notes         String?
  createdAt     DateTime      @default(now())

  @@index([tenantId, createdAt])
}

// Barbero/empleado al que se le puede asignar una cita o venta, para calcular su comisión.
model Barber {
  id                String            @id @default(cuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  phone             String?
  specialty         String?
  paymentType       BarberPaymentType @default(COMISION)
  commissionPercent Float             @default(40)
  salaryCents       Int?
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())

  bookings          Booking[]
  productSales      ProductSale[]
  serviceSales      ServiceSale[]
  preferredByCustomers Customer[]

  @@index([tenantId])
}

// Números que el bot debe ignorar por completo (ej. contactos personales del dueño, si usa su número propio).
model IgnoredContact {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone     String
  label     String?
  createdAt DateTime @default(now())

  @@unique([tenantId, phone])
}

// weekday: 0=domingo, 1=lunes, ... 6=sábado. open/closeMin: minutos desde medianoche (9:00 = 540).
model BusinessHour {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  weekday  Int
  isClosed Boolean @default(false)
  openMin  Int     @default(540)
  closeMin Int     @default(1200)

  @@unique([tenantId, weekday])
}

model StaffUser {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  username     String
  passwordHash String
  role         StaffRole @default(USUARIO)

  permissions Permission[]
  pushTokens  PushToken[]
  createdAt   DateTime     @default(now())

  @@unique([tenantId, username])
}

// Token del dispositivo (celular) de cada usuario, para poder mandarle notificaciones push.
model PushToken {
  id          String    @id @default(cuid())
  staffUserId String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  token       String    @unique
  platform    String    @default("android")
  createdAt   DateTime  @default(now())
}

model Permission {
  id          String    @id @default(cuid())
  staffUserId String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  module      Module
  canView     Boolean   @default(false)
  canAdd      Boolean   @default(false)
  canEdit     Boolean   @default(false)
  canDelete   Boolean   @default(false)

  @@unique([staffUserId, module])
}

model Expense {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  description String
  amountCents Int
  // Si el gasto es una compra de stock a proveedor: qué producto y cuántas piezas se sumaron.
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity    Int?
  paymentMethod PaymentMethod @default(EFECTIVO)
  vendor        String?
  receiptNumber String?
  isRecurring   Boolean         @default(false)
  paidByName    String?
  createdAt   DateTime        @default(now())

  @@index([tenantId, createdAt])
}

model Service {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  priceCents  Int
  durationMin Int     @default(30)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  bookings     Booking[]
  serviceSales ServiceSale[]

  @@index([tenantId])
}

model Product {
  id                 String  @id @default(cuid())
  tenantId           String
  tenant             Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  priceCents         Int
  stock              Int     @default(0)
  lowStockThreshold  Int     @default(3)
  active             Boolean @default(true)
  sortOrder          Int     @default(0)

  sales    ProductSale[]
  expenses Expense[]

  @@index([tenantId])
}

model ProductSale {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])
  productName   String
  priceCents    Int
  barberId      String?
  barber        Barber?       @relation(fields: [barberId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod @default(EFECTIVO)
  paymentStatus PaymentStatus @default(PAGADO)
  amountPaidCents Int         @default(0)
  quantity      Int           @default(1)
  discountCents Int           @default(0)
  tipCents      Int           @default(0)
  notes         String?
  createdAt     DateTime      @default(now())

  @@index([tenantId, createdAt])
}

model Promotion {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  text      String
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean   @default(true)

  @@index([tenantId])
}

model FlowMessage {
  id       String         @id @default(cuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key      FlowMessageKey
  text     String

  @@unique([tenantId, key])
}

model Booking {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerName      String?
  customerPhone     String
  serviceId         String?
  service           Service?       @relation(fields: [serviceId], references: [id])
  barberId          String?
  barber            Barber?        @relation(fields: [barberId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  day               String
  time              String
  scheduledAt       DateTime?
  durationMin       Int            @default(30)
  status            BookingStatus  @default(PENDING)
  priceChargedCents Int?
  paymentMethod     PaymentMethod?
  paymentStatus     PaymentStatus  @default(PAGADO)
  amountPaidCents   Int            @default(0)
  reminderSentAt    DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, scheduledAt])
}

model Payment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amountCents Int
  paidAt     DateTime @default(now())
  periodEnd  DateTime

  @@index([tenantId])
}
