# Desarrollo local (SQLite, no requiere instalar nada):
DATABASE_URL="file:./dev.db"

# Producción (Oracle Cloud + Postgres, ej. Neon/Supabase):
# 1. Cambia el "provider" en prisma/schema.prisma de "sqlite" a "postgresql"
# 2. Pon aquí la cadena de conexión de tu Postgres:
# DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db?sslmode=require"
