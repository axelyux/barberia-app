# Variables del bot de WhatsApp (webhook-router.js + whatsapp-meta-bot.js), pensadas
# para correr en el VPS/Oracle Cloud vía PM2 (ver ecosystem.config.cjs). Copia este
# archivo a ".env" y llena tus valores reales — nunca lo subas a git con datos reales.

# Misma base de datos Postgres que usa el panel (Supabase). El bot solo necesita
# DATABASE_URL (lee/escribe con el cliente Prisma normal, no corre migraciones).
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db?sslmode=require&pgbouncer=true"

# Token que TÚ inventas al configurar el webhook en el panel de Meta (Configuración >
# Webhooks > "Verify token"). Debe ser IDÉNTICO en ambos lados. Sin valor de respaldo:
# si falta, el proceso no arranca (webhook-router.js y whatsapp-meta-bot.js).
META_VERIFY_TOKEN=

# Puerto donde escucha webhook-router.js (el único proceso con URL pública). Default 3100.
ROUTER_PORT=3100

# Nota: NO existe un META_ACCESS_TOKEN global aquí a propósito. Cada barbería tiene su
# propio token de acceso permanente guardado en la columna Tenant.metaAccessToken (junto
# con metaPhoneNumberId y metaPort) porque cada una tiene su propio número de WhatsApp
# Business — un token global rompería el aislamiento multi-tenant. Esos tres campos se
# configuran por barbería (hoy vía Prisma Studio/seed; no hay pantalla dedicada todavía).
